{
  "name": "helpdesk-ticketing-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "HelpDesk Pro - Internal IT Service Management Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=apps/web",
    "test": "npm run test --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "typecheck": "npm run typecheck --workspace=apps/web",
    "seed:firebase": "tsx firebase/seed.ts",
    "firebase:emulators": "npx firebase-tools emulators:start --import=./firebase/emulator-data --export-on-exit",
    "firebase:deploy:rules": "npx firebase-tools deploy --only firestore:rules,firestore:indexes,storage"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "firebase-admin": "^13.0.1",
    "globals": "^15.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "@firebase/util@1.12.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "protobufjs@7.6.6": true
  }
}
