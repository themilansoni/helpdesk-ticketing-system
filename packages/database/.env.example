# Used by Prisma CLI commands (generate/migrate/db push/seed/studio) run
# from this package. See the root .env.example for the full variable list
# and comments.

# SQLite (local dev without Docker - requires `npm run db:use:sqlite` first)
DATABASE_URL="file:./dev.db"

# PostgreSQL (production / default schema provider), e.g.:
# DATABASE_URL="postgresql://user:password@localhost:5432/helpdesk?schema=public"
