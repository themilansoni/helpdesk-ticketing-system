# =========================================
# HelpDesk Pro - Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# =========================================

# ---- Database ----
# Local dev default (no Docker/Postgres required): SQLite file.
# For production, use a PostgreSQL connection string, e.g.:
# postgresql://user:password@host:5432/helpdesk?schema=public
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

# ---- API server ----
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access-secret-change-me
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---- File storage ----
# STORAGE_DRIVER=local | s3
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# S3-compatible storage (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ---- Email notifications ----
# EMAIL_PROVIDER=mock | smtp | sendgrid | ses | graph
EMAIL_PROVIDER=mock
EMAIL_FROM="HelpDesk Pro <helpdesk@example.com>"

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

SENDGRID_API_KEY=

SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_UPN=

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=http://localhost:4000/api
