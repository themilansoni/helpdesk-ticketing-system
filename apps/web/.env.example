# Copy to apps/web/.env.local and fill in with your Firebase project's
# config (Project settings -> Your apps -> the </> web app registration).
# These values are not secrets - they identify which Firebase project to
# talk to, not a credential. Access control is enforced entirely by
# firebase/firestore.rules and firebase/storage.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to run against the local Firebase emulator suite
# (npm run firebase:emulators) instead of your real Firebase project.
VITE_USE_FIREBASE_EMULATORS=false
