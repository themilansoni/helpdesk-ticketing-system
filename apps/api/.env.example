# Copy to apps/api/.env. See the root .env.example for the full variable
# list and comments - this is the minimal set to run the API locally.

# Note: for the sqlite provider, Prisma resolves a relative "file:" path
# relative to packages/database/prisma/schema.prisma (where it's baked in
# at generate time), not relative to this app's cwd - so this always
# points at the one shared dev.db regardless of where the process runs.
DATABASE_URL="file:./dev.db"
# Or, for PostgreSQL (default schema provider):
# DATABASE_URL="postgresql://user:password@localhost:5432/helpdesk?schema=public"

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-please
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

EMAIL_PROVIDER=mock
EMAIL_FROM="HelpDesk Pro <helpdesk@example.com>"
